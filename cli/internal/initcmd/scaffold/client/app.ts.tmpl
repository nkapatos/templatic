// The global client entry: loaded on every page. Client-only behavior
// lives here as hooks; an element opts in with ui.Hook(name, args).
import { defineHook } from "templatic";

// Imported CSS joins the app entry: fingerprinted, linked by templatic.Head.
import "./app.css";

defineHook("autofocus", {
	mounted({ el }) {
		if (el instanceof HTMLElement) el.focus();
	},
});
