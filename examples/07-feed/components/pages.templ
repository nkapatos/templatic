package components

import (
	"github.com/nkapatos/templatic/ui"
)

// Room is a room's page: its chat, the post form and the activity log.
// name prefills the name field; failed is ui.Failed after a refused no-JS
// POST, else nil.
templ Room(room string, messages []Message, events []Event, name string, failed ui.Option) {
	@Layout("#"+room, room) {
		<div class="cols">
			<section>
				<h1>#{ room }</h1>
				// The region around the stream is what a reconnect replays into.
				@Chat.For(room).Region(messages)
				<div { ui.Hook("clear-on-ok", Post.Name())... }>
					@ui.FormFor(Post, "/rooms/"+room+"/messages", failed, ui.Class("post")) {
						<input type="hidden" name="room" value={ room }/>
						@ui.FormError()
						<label>
							Name
							<input name="name" value={ ui.FieldValue(ctx, "name", name) }/>
							@ui.FieldError("name")
						</label>
						<label>
							Message
							<input name="text" autocomplete="off" value={ ui.FieldValue(ctx, "text", "") }/>
							@ui.FieldError("text")
						</label>
						<button type="submit">Send</button>
					}
				</div>
			</section>
			<aside>
				<h2>Activity</h2>
				@ui.Region(ActivityTopic, Activity(events))
			</aside>
		</div>
	}
}

// MessageView is one chat line, inside its stream item wrapper.
templ MessageView(m Message) {
	<time>{ m.At.Format("15:04:05") }</time>
	<strong>{ m.Author }</strong>
	<span>{ m.Text }</span>
}

// Activity is the activity log's stream container, newest first.
templ Activity(events []Event) {
	@ui.Stream(ActivityTopic, activityItems(events))
}

templ activityItems(events []Event) {
	for _, e := range events {
		@ui.StreamItem(e.Key(), EventView(e), ui.Class(e.Kind))
	}
}

// EventView is one activity line, inside its stream item wrapper.
templ EventView(e Event) {
	<time>{ e.At.Format("15:04:05") }</time>
	{ e.Text }
}

// NotFound is the 404 page.
templ NotFound(message string) {
	@Layout("Not found", "") {
		<h1>Not found</h1>
		<p>{ message }</p>
	}
}
