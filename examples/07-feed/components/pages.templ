package components

import (
	"strconv"

	"github.com/nkapatos/templatic/ui"
)

// Room is a room's page: its chat and the activity log, each a collection
// that renders its own container, and the post form. name prefills the name
// field; failed is ui.Failed after a refused no-JS POST, else nil.
templ Room(room string, chat, activity templ.Component, name string, failed ui.Option) {
	@Layout("#"+room, room) {
		<div class="cols">
			<section>
				<h1>#{ room }</h1>
				@chat
				<div { ui.Hook("clear-on-ok", Post.Name())... }>
					@ui.FormFor(Post, "/rooms/"+room+"/messages", failed, ui.Class("post")) {
						@ui.FormError()
						<label>
							Name
							<input name="name" value={ ui.FieldValue(ctx, "name", name) }/>
							@ui.FieldError("name")
						</label>
						<label>
							Message
							<input name="text" autocomplete="off" value={ ui.FieldValue(ctx, "text", "") }/>
							@ui.FieldError("text")
						</label>
						<button type="submit">Send</button>
					}
				</div>
			</section>
			<aside>
				<h2>Activity</h2>
				@activity
			</aside>
		</div>
	}
}

// MessageView is one chat line, inside the <li> its collection renders, with
// a like and a delete form: both work with and without JavaScript.
templ MessageView(m Message) {
	<time>{ m.At.Format("15:04:05") }</time>
	<strong>{ m.Author }</strong>
	<span>{ m.Text }</span>
	@ui.FormFor(Like, messageURL(m)+"/like", ui.Class("act")) {
		<button type="submit" aria-label="Like">♥ { strconv.Itoa(m.Likes) }</button>
	}
	@ui.FormFor(Delete, messageURL(m)+"/delete", ui.Class("act")) {
		<button type="submit" aria-label="Delete">✕</button>
	}
}


// EventView is one activity line, inside the <li> its collection renders.
templ EventView(e Event) {
	<time>{ e.At.Format("15:04:05") }</time>
	{ e.Text }
}

// NotFound is the 404 page.
templ NotFound(message string) {
	@Layout("Not found", "") {
		<h1>Not found</h1>
		<p>{ message }</p>
	}
}
