package components

import "github.com/nkapatos/templatic"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · bootstrap</title>
			<link rel="icon" href="/static/favicon.svg"/>
			// Bootstrap's CSS is part of the app bundle: Head links it.
			@templatic.Head(templatic.HeadOptions{Assets: "/_templatic"})
			// Without JS no collapse can open, so show their content.
			<noscript><style>.collapse:not(.show) { display: block; }</style></noscript>
		</head>
		<body>
			<nav class="navbar navbar-expand bg-body-tertiary border-bottom mb-4">
				<div class="container">
					<a class="navbar-brand" href="/">bootstrap</a>
					<ul class="navbar-nav">
						<li class="nav-item"><a class="nav-link" href="/">Board</a></li>
						<li class="nav-item"><a class="nav-link" href="/report">Report</a></li>
					</ul>
				</div>
			</nav>
			<main class="container">
				{ children... }
			</main>
			@templatic.Boot(templatic.BootOptions{Live: "/live", Assets: "/_templatic"})
		</body>
	</html>
}
