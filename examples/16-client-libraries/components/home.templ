package components

import (
	"strconv"
	"time"

	"github.com/nkapatos/templatic/live"
	"github.com/nkapatos/templatic/ui"
)

// Home shows the shared queue and the stats, both world regions.
templ Home(queue, stats *live.Region) {
	@Layout("Queue") {
		<h1>Release queue</h1>
		<p>Drag a task by its handle, or use the arrows. Every open page shows the same order.</p>
		@queue
		<h2>Today</h2>
		@stats
	}
}

// Queue is the queue region. The sortable hook drags its items; the forms
// move them without JavaScript.
templ Queue(tasks []Task) {
	<ol class="queue" { ui.Hook("sortable", nil)... }>
		for i, t := range tasks {
			<li id={ "task-" + t.ID } data-id={ t.ID }>
				<span class="grip" aria-hidden="true">⠿</span>
				<span class="title">{ t.Title }</span>
				@ui.FormFor(Move, "/move", ui.Class("move")) {
					<input type="hidden" name="id" value={ t.ID }/>
					<button type="submit" name="to" value={ strconv.Itoa(i - 1) } disabled?={ i == 0 } aria-label={ "Move " + t.Title + " up" }>↑</button>
					<button type="submit" name="to" value={ strconv.Itoa(i + 1) } disabled?={ i == len(tasks)-1 } aria-label={ "Move " + t.Title + " down" }>↓</button>
				}
			</li>
		}
	</ol>
}

// StatsView is the stats region. The text is the server's fallback; the
// intl hook reformats it from the value and datetime attributes.
templ StatsView(s Stats) {
	<dl class="stats">
		<dt>Revenue</dt>
		<dd><data value={ strconv.FormatFloat(s.Revenue, 'f', 2, 64) } data-currency={ s.Currency } { ui.Hook("intl", "currency")... }>{ strconv.FormatFloat(s.Revenue, 'f', 2, 64) } { s.Currency }</data></dd>
		<dt>Visitors</dt>
		<dd><data value={ strconv.Itoa(s.Visitors) } { ui.Hook("intl", "number")... }>{ strconv.Itoa(s.Visitors) }</data></dd>
		<dt>Last reorder</dt>
		<dd>@stamp(s.Reordered, "relative")</dd>
		<dt>Server time</dt>
		<dd>@stamp(s.Now, "datetime")</dd>
	</dl>
}

templ stamp(t time.Time, kind string) {
	<time datetime={ t.UTC().Format(time.RFC3339) } { ui.Hook("intl", kind)... }>{ t.UTC().Format("2006-01-02 15:04:05 UTC") }</time>
}
