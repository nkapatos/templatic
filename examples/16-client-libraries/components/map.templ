package components

import "strconv"

// The body is the fallback: a table of the places. The lit element
// replaces it with a Leaflet map when it mounts.
//
//templatic:island tag=place-map props=MapProps variant=lit
templ PlaceMap(props MapProps) {
	<table class="fallback">
		<caption>Offices</caption>
		<thead><tr><th>Place</th><th>Latitude</th><th>Longitude</th></tr></thead>
		<tbody>
			for _, p := range props.Places {
				<tr><td>{ p.Name }</td><td>{ strconv.FormatFloat(p.Lat, 'f', 4, 64) }</td><td>{ strconv.FormatFloat(p.Lng, 'f', 4, 64) }</td></tr>
			}
		</tbody>
	</table>
}

// MapPage is the only page that renders the island, so the only one that loads Leaflet.
templ MapPage(props MapProps) {
	@Layout("Map") {
		<h1>Offices</h1>
		@PlaceMapIsland(props)
	}
}
