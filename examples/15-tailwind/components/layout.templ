package components

import "github.com/nkapatos/templatic"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href="/static/favicon.svg"/>
			// Links the bundle's CSS, Tailwind's output included.
			@templatic.Head(templatic.HeadOptions{Assets: "/_templatic"})
		</head>
		<body class="bg-slate-50 font-sans">
			<main class="mx-auto mt-12 max-w-xl px-4">
				{ children... }
			</main>
			@templatic.Boot(templatic.BootOptions{Live: "/live", Assets: "/_templatic"})
		</body>
	</html>
}
