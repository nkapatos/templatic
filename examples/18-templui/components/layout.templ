package components

import "github.com/nkapatos/templatic"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			// The app's own file, served by the app (see main.go).
			<link rel="icon" href="/static/favicon.svg"/>
			// Stylesheets and modulepreload hints from the manifest, early.
			// The manifest and the page token come from templatic.App.
			@templatic.Head(templatic.HeadOptions{Assets: "/_templatic"})
		</head>
		<body>
			<main>
				{ children... }
			</main>
			@templatic.Boot(templatic.BootOptions{Live: "/live", Assets: "/_templatic"})
		</body>
	</html>
}
