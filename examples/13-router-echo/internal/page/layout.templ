package page

import "github.com/nkapatos/templatic"

// Layout is the document every page renders in.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · items</title>
			<link rel="icon" href="/static/favicon.svg"/>
			@templatic.Head(templatic.HeadOptions{Assets: "/_templatic"})
		</head>
		<body>
			<header>
				<a class="brand" href="/">items</a>
			</header>
			<main>
				{ children... }
			</main>
			<footer>Open an item in two windows and like it in one.</footer>
			// Live names where main.go mounts the stream and the commands.
			@templatic.Boot(templatic.BootOptions{Live: "/live", Assets: "/_templatic"})
		</body>
	</html>
}

// NotFound is the 404 page.
templ NotFound(message string) {
	@Layout("Not found") {
		<h1>Not found</h1>
		<p>{ message }</p>
		<p><a href="/">Back to the list</a></p>
	}
}
