package components

import (
	"github.com/nkapatos/templatic/live"
	"github.com/nkapatos/templatic/ui"
)

templ Home(level *live.Cell[int]) {
	@Layout("Tank") {
		<h1>One shared tank</h1>
		<p>
			The server drains the tank by one every second. Anyone can fill it.
			Every open page shows the same level.
		</p>
		<p class="level">
			// Text: the runtime replaces the span's text on every change.
			@ui.Cell(level)
			<span class="max">/ 100</span>
		</p>
		// Attribute: the same value drives the meter's value attribute.
		<meter min="0" max="100" low="20" high="80" optimum="100" { ui.CellAttr(level, "value")... }></meter>
		// A div: a one-button form cannot sit inside a <p>.
		<div class="actions">
			// Buttons carry a fixed input; PostTo makes each a one-button
			// form, so a press works without JavaScript too.
			@ui.Button(Fill, FillIn{Amount: 10}, ui.PostTo("/fill")) {
				Fill 10
			}
			@ui.Button(Fill, FillIn{Amount: 50}, ui.PostTo("/fill")) {
				Fill 50
			}
			@ui.Button(Empty, struct{}{}, ui.PostTo("/empty"), ui.Class("secondary")) {
				Empty
			}
		</div>
		<noscript>Without JavaScript this page shows the level at load time; a press reloads it with the new level.</noscript>
	}
}
