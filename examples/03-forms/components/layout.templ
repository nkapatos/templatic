package components

import "github.com/nkapatos/templatic"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · forms</title>
			<link rel="icon" href="/static/favicon.svg"/>
			@templatic.Head(templatic.HeadOptions{Assets: "/_templatic"})
		</head>
		<body>
			<header>
				<a class="brand" href="/">forms</a>
			</header>
			<main>
				{ children... }
			</main>
			<footer>The same forms work with JavaScript turned off.</footer>
			@templatic.Boot(templatic.BootOptions{Live: "/live", Assets: "/_templatic"})
		</body>
	</html>
}
