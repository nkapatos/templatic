package components

import (
	"strconv"

	"github.com/nkapatos/templatic/ui"
)

templ Home(p Page, tip int) {
	@Layout("Home", p) {
		<h1>Client-only behavior with hooks</h1>
		<p>
			The menu, the theme toggle and the help dialog run in the browser,
			with no request to the server.
		</p>
		// Without JS the link opens the help page; with JS the hook opens
		// the same content as a modal dialog.
		<p><a href="/help" { ui.Hook("dialog", DialogArgs{ID: "help-dialog"})... }>Open help</a></p>
		// Render paints the region marker with the first tip inside.
		@TipCard.Render(tip)
		<dialog id="help-dialog" aria-labelledby="help-title">
			<div class="dialog-body">
				<h2 id="help-title">Help</h2>
				@helpBody()
				<form method="dialog">
					<button>Close</button>
				</form>
			</div>
		</dialog>
	}
}

templ Help(p Page) {
	@Layout("Help", p) {
		<h1>Help</h1>
		@helpBody()
		<p><a href="/">Back home</a></p>
	}
}

templ NotFound(p Page) {
	@Layout("Not found", p) {
		<h1>Not found</h1>
		<p><a href="/">Back home</a></p>
	}
}

templ helpBody() {
	<ul>
		<li><strong>Menu</strong>: click it, press Escape or click outside to close.</li>
		<li><strong>Theme</strong>: the choice is a cookie; the server reads it before the page paints.</li>
		<li><strong>Help dialog</strong>: Escape, the Close button or a click on the backdrop closes it.</li>
	</ul>
}

// The id differs per tip, so a swap inserts a new card instead of morphing
// the old one: the menu hook mounts on the new element.
templ tipCard(n int) {
	<article class="tip" id={ "tip-" + strconv.Itoa(n) }>
		<header>
			<h2>{ tips[n].Title }</h2>
			<details class="menu" { ui.Hook("menu", nil)... }>
				<summary>More</summary>
				<ul>
					<li><a href={ templ.SafeURL(TipURL(n)) }>Link to this tip</a></li>
					<li><a href="/help">Help</a></li>
				</ul>
			</details>
		</header>
		<p>{ tips[n].Body }</p>
		@ui.Link(ShowTip, TipIn{N: next(n)}, TipURL(next(n))) {
			Next tip
		}
	</article>
}
